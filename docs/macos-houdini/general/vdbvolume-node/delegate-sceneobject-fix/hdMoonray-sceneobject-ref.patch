+// Resolve a single prim-path string to an rdl2 SceneObject via the render
+// delegate. Empty path -> nullptr (clears the reference). Unresolved path ->
+// nullptr + a warning (the referenced prim may not exist or not be synced yet).
+static SceneObject*
+_resolveSceneObjectRef(RenderDelegate* renderDelegate, const std::string& path,
+                       const SceneObject* sceneObj, const Attribute* attribute)
+{
+    if (path.empty()) return nullptr;
+    SceneObject* obj = renderDelegate->getSceneObject(path);
+    if (!obj) {
+        Logger::warn(sceneObj->getName(), '.', attribute->getName(),
+                     ": could not resolve SceneObject reference '", path,
+                     "' (referenced prim does not exist or is not synced yet)");
+    }
+    return obj;
+}
+
+// Extract a single prim path from a VtValue holding a string, SdfPath or token.
+// Returns false if the value holds none of those types.
+static bool
+_extractPath(const pxr::VtValue& val, std::string* out)
+{
+    if (val.IsHolding<std::string>())        { *out = val.UncheckedGet<std::string>(); return true; }
+    if (val.IsHolding<pxr::SdfPath>())       { *out = val.UncheckedGet<pxr::SdfPath>().GetString(); return true; }
+    if (val.IsHolding<pxr::TfToken>())       { *out = val.UncheckedGet<pxr::TfToken>().GetString(); return true; }
+    return false;
+}
