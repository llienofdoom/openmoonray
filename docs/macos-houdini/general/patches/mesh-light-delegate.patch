+// Houdini's "Point" light authors a UsdLuxSphereLight with treatAsPoint=true and does not
+// author a radius, so radius falls back to the UsdLux schema default (0.5). Detect that so the
+// SphereLight (and the spotlight lens_radius derived from it) can be shrunk to a near-point.
+static bool
+treatAsPoint(const pxr::SdfPath& id, pxr::HdSceneDelegate* sceneDelegate)
+{
+    static const pxr::TfToken treatAsPointToken("treatAsPoint");
+    pxr::VtValue v = sceneDelegate->GetLightParamValue(id, treatAsPointToken);
+    return v.IsHolding<bool>() && v.UncheckedGet<bool>();
+}
+
+// Small non-zero radius approximating a zero-size point light. MoonRay bakes the sphere radius
+// into the light's transform (SphereLight.cc) and rejects a zero radius as a singular transform
+// ("Invalid transform on light - setting to off"), so a true 0 disables the light. This epsilon
+// keeps the transform valid while staying visually point-like. Paired with forced normalized=true
+// (below) so the tiny emitting area does not scale the light's energy toward zero.
+static constexpr float sTreatAsPointRadius = 0.01f;
