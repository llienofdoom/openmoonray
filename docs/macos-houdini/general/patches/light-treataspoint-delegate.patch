+            } else if (luxName == pxr::HdLightTokens->radius && treatAsPoint(id, sceneDelegate)) {
+                // treatAsPoint=true (Houdini "Point" light): shrink the SphereLight radius /
+                // spotlight lens_radius to a near-point instead of the 0.5 schema default, which
+                // otherwise makes a point behave like a 0.5 sphere with an oversized spot lens.
+                mLight->set(AttributeKey<float>(**it), sTreatAsPointRadius);
+                continue;
+            } else if (luxName == pxr::HdLightTokens->normalize && treatAsPoint(id, sceneDelegate)) {
+                // A point light's intensity is its power. Force normalized=true so the tiny
+                // radius above does not scale the emitted energy toward zero (normalized=false
+                // multiplies radiance by area, which for a near-point is ~0).
+                mLight->set(AttributeKey<bool>(**it), true);
+                continue;
             } else if (luxName == pxr::HdLightTokens->color) {
                 pxr::GfVec3f color(1.0f);
