+# MoonrayLightFilterAdapter.cc includes usdImaging/lightFilterAdapter.h which triggers
+# instantiation of SdfChildrenProxy<_View>::_ValueProxy::operator= — a method that calls
+# _Set() on SdfChildrenProxy, which doesn't exist in Houdini 20.5's USD 24.3 headers.
+# Exclude it from Houdini builds; light filter adapters are not needed for basic integration.
+if (NOT MOONRAY_USE_HOUDINI)
+    target_sources(${component} PRIVATE MoonrayLightFilterAdapter.cc)
+endif()
