+# For Houdini builds: CMAKE_CXX_FLAGS puts toolkit/include (USD 24.3) in
+# OTHER_CPLUSPLUSFLAGS but the Xcode generator places SYSTEM_HEADER_SEARCH_PATHS
+# BEFORE OTHER_CPLUSPLUSFLAGS in the compile command. installs/include (which has
+# conflicting USD 22.11 pxr headers) sits in SYSTEM_HEADER_SEARCH_PATHS and wins.
+# The fix: temporarily disable installs/include/pxr/ before building so clang
+# falls through to toolkit/include (in OTHER_CPLUSPLUSFLAGS). Use build-houdini.sh
+# in the docs/ directory to automate the disable/build/restore cycle.
+if (MOONRAY_USE_HOUDINI AND NOT "$ENV{PXR_INCLUDE_PREFIX}" STREQUAL "")
+    message(STATUS "HdMoonray Houdini build: use build-houdini.sh to build (disables standalone pxr headers during compile to force USD 24.3)")
+endif()
+
 # This is needed for linking against the USD 0.25.5 libraries
 # as they depend on OpenGL but don't specify it in
 # their cmake config.
